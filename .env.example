# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Optional, defaults to "roomwise"
MONGODB_DB=roomwise

# Password for the housekeeping dashboard
STAFF_PASSWORD=change-me
# Signs the staff session cookie. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Guest sign-in codes are emailed from this Gmail account (needs 2-Step Verification + an App Password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
